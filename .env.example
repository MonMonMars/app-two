# App Two — copy to `.env.local` and replace placeholders (test mode only).

# Public site URL (used for Stripe return URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe test keys (never commit real secrets)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create in Stripe Dashboard → Products, test mode)
STRIPE_PRICE_PREMIUM_MONTHLY=price_premium_monthly_test
STRIPE_PRICE_PREMIUM_ANNUAL=price_premium_annual_test
STRIPE_PRICE_BOOST=price_boost_test
STRIPE_PRICE_SUPER_LIKES=price_super_likes_test
